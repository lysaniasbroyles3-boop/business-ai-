* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at top, #16251c, #050605 55%);
  color: white;
  font-family: Arial, Helvetica, sans-serif;
}

button,
input {
  font-family: inherit;
}

button {
  cursor: pointer;
}

.topbar {
  max-width: 1100px;
  margin: auto;
  padding: 25px 25px;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 27px;
  font-weight: 900;
  letter-spacing: 2px;
}

.logo span {
  color: #48e77b;
}

.status {
  display: flex;
  align-items: center;
  gap: 8px;

  font-size: 11px;
  font-weight: bold;
  color: #a0aaa3;
}

.status span {
  width: 9px;
  height: 9px;
  border-radius: 50%;

  background: #48e77b;

  box-shadow: 0 0 12px #48e77b;
}

main {
  max-width: 1100px;
  margin: auto;
  padding: 20px 25px 60px;
}

.hero {
  text-align: center;
  padding: 80px 15px 65px;
}

.eyebrow {
  color: #48e77b;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 3px;
}

.hero h1 {
  font-size: clamp(48px, 9vw, 90px);
  line-height: .95;
  margin: 20px 0;
  letter-spacing: -4px;
}

.hero h1 span {
  color: #48e77b;
}

.description {
  max-width: 560px;
  margin: 0 auto 30px;

  color: #9ca69f;
  line-height: 1.6;
}

.ai-button {
  border: none;
  border-radius: 16px;

  padding: 18px 27px;

  background: #48e77b;
  color: #061008;

  font-size: 15px;
  font-weight: 900;

  box-shadow: 0 10px 35px rgba(72, 231, 123, .2);

  transition: .15s;
}

.ai-button:hover {
  transform: translateY(-2px);
}

.services {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.service {
  display: flex;
  align-items: center;
  gap: 15px;

  text-align: left;

  min-height: 125px;
  padding: 20px;

  background: rgba(18, 24, 20, .9);
  color: white;

  border: 1px solid #29362d;
  border-radius: 20px;

  transition: .15s;
}

.service:hover {
  transform: translateY(-3px);
  border-color: #48e77b;
}

.service-icon {
  width: 50px;
  height: 50px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #202b23;
  border-radius: 15px;

  font-size: 25px;
}

.service h2 {
  font-size: 17px;
  margin: 0 0 5px;
}

.service p {
  color: #858f88;
  font-size: 12px;
  margin: 0;
}

.service strong {
  margin-left: auto;
  font-size: 20px;
}

.ai-panel {
  margin-top: 25px;

  padding: 25px;

  border: 1px solid #315c40;
  border-radius: 22px;

  background:
    linear-gradient(145deg, #122017, #080b09);
}

.ai-header {
  display: flex;
  align-items: center;
  gap: 14px;
}

.ai-logo {
  width: 52px;
  height: 52px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #203226;
  border-radius: 16px;

  font-size: 27px;
}

.ai-header h2 {
  margin: 0;
}

.ai-header p {
  margin: 4px 0 0;
  color: #87938b;
  font-size: 12px;
}

.ai-status {
  color: #48e77b;
  font-size: 10px;
  font-weight: bold;
  margin: 20px 0 10px;
}

.chat-box {
  min-height: 100px;

  padding: 17px;

  background: #080b09;
  border: 1px solid #202b24;
  border-radius: 15px;

  color: #b4beb7;
}

.chat-input {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.chat-input input {
  flex: 1;

  padding: 15px;

  border-radius: 14px;
  border: 1px solid #29372e;

  background: #0c100d;
  color: white;

  outline: none;
}

.chat-input button {
  width: 52px;

  border: none;
  border-radius: 14px;

  background: #48e77b;
  color: #061008;

  font-size: 20px;
  font-weight: bold;
}

.featured {
  margin-top: 25px;
  padding: 35px;

  border-radius: 22px;

  background: #111711;
  border: 1px solid #27342b;
}

.featured p {
  color: #48e77b;
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: bold;
}

.featured h2 {
  font-size: 35px;
  margin: 10px 0 25px;
}

.featured button {
  padding: 14px 20px;

  border-radius: 12px;

  background: #202a23;
  color: white;

  border: 1px solid #354338;
}

footer {
  text-align: center;
  color: #59635d;
  font-size: 10px;
  padding: 30px;
}

#toast {
  position: fixed;

  bottom: 30px;
  left: 50%;

  transform: translateX(-50%);

  background: #48e77b;
  color: #061008;

  padding: 13px 20px;

  border-radius: 20px;

  font-size: 12px;
  font-weight: bold;

  opacity: 0;
  transition: .2s;
}

#toast.show {
  opacity: 1;
}

@media (max-width: 700px) {

  .hero {
    padding-top: 50px;
  }

  .services {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    letter-spacing: -2px;
  }

}
